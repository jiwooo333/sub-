local frameCounter = 0

RunService.RenderStepped:Connect(function(dt)
    frameCounter = frameCounter + 1
    if frameCounter % 2 == 0 then Petals:step(dt * 2, os.clock()) end

    local char = localPlayer.Character
    if char then globalRayParams.FilterDescendantsInstances = {char} end
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    Workspace.Gravity = settingsData.Gravity

    if settingsData.VelocitySpeed and hrp and hum then
        local moveDir = hum.MoveDirection
        if moveDir.Magnitude > 0 then
            hrp.Velocity = Vector3.new(moveDir.X * settingsData.VelocityValue, hrp.Velocity.Y, moveDir.Z * settingsData.VelocityValue)
        end
    end

    if settingsData.ThirdPerson then localPlayer.CameraMaxZoomDistance = settingsData.ThirdPersonDist localPlayer.CameraMinZoomDistance = settingsData.ThirdPersonDist
    else localPlayer.CameraMaxZoomDistance = 400 localPlayer.CameraMinZoomDistance = 0.5 end

    if settingsData.NoClip and char then for _, p in pairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end end
    if hum then hum.WalkSpeed = settingsData.SpeedEnabled and settingsData.SpeedValue or 16 end
    if hum and settingsData.JumpPower then hum.JumpPower = 100 end

    if settingsData.FlyEnabled then
        if not flying and hrp then startFly() end
        if flying and hrp and bg and bv then
            bg.cframe = camera.CFrame
            local moveDir = Vector3.new(0,0,0)
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camera.CFrame.RightVector end
            bv.velocity = moveDir * settingsData.FlySpeed
            if hum then hum.PlatformStand = true end
        end
    else if flying then stopFly() if hum then hum.PlatformStand = false end end end

    if settingsData.SpinEnabled and hrp then hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(settingsData.SpinSpeed), 0) end
    if settingsData.BhopEnabled and hum and hum.FloorMaterial ~= Enum.Material.Air then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    if settingsData.FullBright then Lighting.Brightness = 2 Lighting.ClockTime = 14 Lighting.GlobalShadows = false Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255) end
    if settingsData.NightMode then Lighting.ClockTime = 0 end
    if settingsData.DayMode then Lighting.ClockTime = 12 end
    if settingsData.RemoveFog then Lighting.FogEnd = 9e9 end

    if settingsData.AutoReload and char then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then
            local ammo = tool:FindFirstChild("Ammo") or tool:FindFirstChild("CurrentAmmo")
            if ammo and ammo:IsA("IntValue") and ammo.Value == 0 then pcall(function() game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.R, false, game) task.wait(0.1) game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.R, false, game) end) end
        end
    end

    if settingsData.FakeLag and frameCounter % 15 == 0 and hrp then hrp.Anchored = true task.wait(0.05) hrp.Anchored = false end
    if settingsData.RageFakeLag and frameCounter % 25 == 0 and hrp then hrp.Anchored = true task.wait(0.1) hrp.Anchored = false end
    if settingsData.RageAntiAim and hrp then hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(math.random(-180, 180)), 0) end
    if settingsData.AstralProjection and hrp then 
        hrp.CFrame = CFrame.new(0, 10000, 0)
        hrp.Anchored = true
        camera.CameraSubject = nil
    elseif not settingsData.AstralProjection and hrp and camera.CameraSubject == nil then
        local hum = localPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then camera.CameraSubject = hum end
    end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= localPlayer and p.Character then
            local tChar, tHum, tHead, tHrp = p.Character, p.Character:FindFirstChildOfClass("Humanoid"), p.Character:FindFirstChild("Head"), p.Character:FindFirstChild("HumanoidRootPart")
            if tHum and tHead and tHrp and tHum.Health > 0 then
                local isTeammate = (localPlayer.Team and p.Team and localPlayer.Team == p.Team)
                local isVisible = true
                if settingsData.WallCheck or settingsData.ESPWallCheck then
                    local rayRes = Workspace:Raycast(camera.CFrame.Position, (tHead.Position - camera.CFrame.Position), globalRayParams)
                    if rayRes and not rayRes.Instance:IsDescendantOf(tChar) then isVisible = false end
                end

                local hl, bb = tChar:FindFirstChild("RatESP"), tHead:FindFirstChild("RatBB")
                if espDrawings[p] == nil then espDrawings[p]="failed" pcall(function() local b=Drawing.new("Square") b.Visible=false b.Color=Color3.new(1,1,1) b.Thickness=1.5 b.Filled=false espDrawings[p]=b end) end
                local dBox = type(espDrawings[p]) ~= "string" and espDrawings[p] or nil

                if settingsData.ESPEnabled and not isTeammate then
                    if settingsData.EspType == "Highlight" then
                        if not hl then hl = Instance.new("Highlight", tChar) hl.Name = "RatESP" end
                        hl.Enabled = true hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop hl.OutlineTransparency = 0.3 hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        if not isVisible and settingsData.ESPWallCheck then hl.FillColor = Color3.fromRGB(255, 255, 255) hl.FillTransparency = 0.4
                        elseif settingsData.ColorChange then hl.FillColor = Color3.fromRGB(0, 0, 255) hl.FillTransparency = 0.5
                        else hl.FillColor = Color3.fromRGB(200, 200, 200) hl.FillTransparency = 0.5 end
                        if dBox then dBox.Visible = false end
                    elseif settingsData.EspType == "2D Box" or settingsData.EspType == "Corner Box" then
                        if hl then hl.Enabled = false end
                        if dBox then
                            local hPos, onScr = camera:WorldToViewportPoint(tHrp.Position)
                            if onScr then
                                local size = Vector2.new(2500 / hPos.Z, 3500 / hPos.Z)
                                dBox.Size = size
                                dBox.Position = Vector2.new(hPos.X - size.X / 2, hPos.Y - size.Y / 2)
                                dBox.Visible = true
                                if not isVisible and settingsData.ESPWallCheck then dBox.Color = Color3.new(1, 0, 0) else dBox.Color = Color3.new(1, 0.2, 0.2) end
                            else dBox.Visible = false end
                        end
                    end
                    
                    if settingsData.SkeletonESP then
                        if espSkeletons[p] == nil then
                            espSkeletons[p] = "failed"
                            local lines = {}
                            local success = pcall(function() for i=1, 14 do local l=Drawing.new("Line") l.Visible=false l.Color=Color3.new(1,1,1) l.Thickness=1.5 table.insert(lines, l) end end)
                            if success and #lines == 14 then espSkeletons[p] = lines end
                        end
                        if type(espSkeletons[p]) == "table" and #espSkeletons[p] == 14 then
                            for i, link in ipairs(skeletonLinks) do
                                local p1, p2 = tChar:FindFirstChild(link[1]), tChar:FindFirstChild(link[2])
                                if p1 and p2 then
                                    local pos1, on1 = camera:WorldToViewportPoint(p1.Position)
                                    local pos2, on2 = camera:WorldToViewportPoint(p2.Position)
                                    if on1 or on2 then
                                        espSkeletons[p][i].From = Vector2.new(pos1.X, pos1.Y)
                                        espSkeletons[p][i].To = Vector2.new(pos2.X, pos2.Y)
                                        espSkeletons[p][i].Visible = true
                                        if not isVisible and settingsData.ESPWallCheck then espSkeletons[p][i].Color = Color3.new(1,0,0) else espSkeletons[p][i].Color = Color3.new(1,1,1) end
                                    else espSkeletons[p][i].Visible = false end
                                else espSkeletons[p][i].Visible = false end
                            end
                        end
                    else
                        if espSkeletons[p] then for _, l in ipairs(espSkeletons[p]) do l.Visible = false end end
                    end

                    if settingsData.NameESP or settingsData.DistanceESP or settingsData.HealthESP then
                        if not bb then
                            bb = Instance.new("BillboardGui", tHead) bb.Name = "RatBB" bb.Size = UDim2.new(0, 200, 0, 50) bb.StudsOffset = Vector3.new(0, 2.5, 0) bb.AlwaysOnTop = true
                            local txt = Instance.new("TextLabel", bb) txt.Name = "Info" txt.Size = UDim2.new(1, 0, 1, 0) txt.BackgroundTransparency = 1 txt.TextColor3 = Color3.fromRGB(255,255,255) txt.Font = Enum.Font.GothamBold txt.TextSize = 13
                        end
                        local str = ""
                        if settingsData.NameESP then str = str .. p.Name end
                        if settingsData.HealthESP then str = str .. " [" .. math.floor(tHum.Health) .. "HP]" end
                        if settingsData.DistanceESP and hrp then str = str .. " [" .. math.floor((hrp.Position - tHead.Position).Magnitude) .. "m]" end
                        bb.Info.Text = str bb.Enabled = true
                    else if bb then bb.Enabled = false end end
                else if hl then hl:Destroy() end if bb then bb:Destroy() end end

                if not isTeammate then
                    if settingsData.HitboxEnabled then
                        local hs = settingsData.HitboxSize
                        tHead.Size = Vector3.new(hs, hs, hs)
                        tHead.Transparency = 0.7
                        tHead.CanCollide = false
                    else
                        tHead.Size = Vector3.new(1.2, 1.2, 1.2)
                        tHead.Transparency = 0
                    end

                    local tPart = tHead
                    local predPos = tPart.Position
                    if settingsData.Prediction then predPos = predPos + (tPart.Velocity * 0.12) end
                    if settingsData.PingPrediction then
                        local ping = 50
                        pcall(function() ping = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() end)
                        predPos = predPos + (tPart.Velocity * (ping / 1000))
                    end

                    local sPos, onScreen = camera:WorldToViewportPoint(predPos)
                    if settingsData.RageAimbot then
                        if settingsData.RageBaimLethal and tHum.Health <= settingsData.RageMinDmg then tPart = tHrp predPos = tPart.Position end
                        if settingsData.Resolver then tPart.Velocity = Vector3.zero predPos = tPart.Position end
                        if settingsData.RageAutoWall or isVisible then
                            camera.CFrame = CFrame.new(camera.CFrame.Position, predPos)
                            if settingsData.RageAutoShoot then
                                pcall(function() mouse1click() end)
                            end
                        end
                    elseif onScreen then
                        local dist = (Vector2.new(sPos.X, sPos.Y) - UserInputService:GetMouseLocation()).Magnitude
                        if (settingsData.AimbotEnabled or settingsData.SilentAim) and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                            if (not settingsData.FOVEnabled or dist <= settingsData.FOVSize) and (not settingsData.WallCheck or isVisible) then
                                camera.CFrame = camera.CFrame:Lerp(CFrame.new(camera.CFrame.Position, predPos), 1 / settingsData.AimSmooth)
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- 8. Client-Side Skin Changer Loop
coroutine.wrap(function()
    local hue = 0
    while task.wait(0.1) do
        hue = hue + 0.05
        if hue > 1 then hue = 0 end
        if settingsData.SkinChanger and localPlayer.Character then
            local cColor = Color3.fromHSV(hue, 1, 1)
            for _, obj in pairs(localPlayer.Character:GetChildren()) do
                if obj:IsA("Tool") or obj:IsA("Model") and obj.Name ~= "HumanoidRootPart" then
                    for _, part in pairs(obj:GetDescendants()) do
                        if part:IsA("BasePart") or part:IsA("MeshPart") then
                            pcall(function()
                                part.Material = Enum.Material.ForceField
                                part.Color = cColor
                                if part:IsA("Texture") or part:IsA("Decal") then part:Destroy() end
                            end)
                        end
                    end
                end
            end
        end
    end
end)()

