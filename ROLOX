-- 2. Blood Petals UI Effect
local Petals = { list = {}, visible = true }
function Petals:spawnOne()
    local s = math.random(6, 12)
    local f = Instance.new("Frame")
    f.Size = UDim2.fromOffset(s, math.floor(s * 0.62))
    f.BorderSizePixel = 0
    f.BackgroundTransparency = 0.2 + math.random() * 0.4
    f.BackgroundColor3 = Color3.fromRGB(200, 200, 200):Lerp(Color3.fromRGB(150, 10, 10), math.random() * 0.5)
    f.Rotation = math.random(0, 360)
    f.ZIndex = 1
    f.Parent = screenGui
    Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
    table.insert(self.list, {
        f = f, x = math.random(), y = math.random() * 1.2 - 0.1,
        vy = 0.05 + math.random() * 0.07, sway = 0.01 + math.random() * 0.03,
        phase = math.random() * 6.28, spin = (math.random() - 0.5) * 160
    })
end
for i = 1, 15 do Petals:spawnOne() end
function Petals:step(dt, t)
    for _, p in ipairs(self.list) do
        p.y = p.y + p.vy * dt
        if p.y > 1.08 then p.y = -0.08; p.x = math.random() end
        p.f.Position = UDim2.fromScale(p.x + math.sin(t * 0.9 + p.phase) * p.sway, p.y)
        p.f.Rotation = p.f.Rotation + p.spin * dt
    end
end

